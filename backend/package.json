{
  "name": "restaurantos-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "test": "cross-env NODE_ENV=test LOG_LEVEL=silent mocha --reporter spec --exit --timeout 20000 --file test/setup.mjs \"test/**/*.test.mjs\"",
    "docker:up": "docker-compose -f ../docker-compose.yml up --build"
  },
  "dependencies": {
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^6.11.2",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^7.5.0",
    "mongoose": "^7.8.1",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.7.2",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/supertest": "^2.0.12",
    "cross-env": "^7.0.3",
    "mocha": "^10.2.0",
    "mongodb-memory-server": "^8.12.0",
    "supertest": "^6.3.3",
    "tsx": "^3.14.0",
    "typescript": "^5.9.3"
  }
}
