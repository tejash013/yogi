# Production database
MONGODB_URI="mongodb+srv://user:password@cluster.example.mongodb.net/restaurantos"
MONGODB_DATABASE="restaurantos"

# JWT secrets
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SMTP for sending emails (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@example.com"

# Frontend URL used in password reset links
# Comma-separated frontend origins. Production must use HTTPS.
FRONTEND_URL=http://localhost:5173

# Cloudinary image storage (use either CLOUDINARY_URL or all three values)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
