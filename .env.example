# Frontend Environment Variables
# Local development:
VITE_API_URL=http://localhost:3000

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Production: set this in your frontend hosting provider (Vercel) to the public backend URL.
# Example: VITE_API_URL=https://restaurantos-backend.onrender.com
